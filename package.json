{
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "tesseract.js": "^6.0.1"
  },
  "description": "App de finanzas para una pareja (2 usuarios): control mutuo de ingresos, gastos, presupuesto por sobres, metas y deuda mutua. Español latinoamericano, MXN por defecto.",
  "devDependencies": {
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "vite-plugin-pwa": "^0.20.0"
  },
  "name": "finanzas-en-pareja",
  "private": true,
  "scripts": {
    "build": "tsc -b && vite build",
    "dev": "vite",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test:reminders": "esbuild scripts/test-reminders.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/test-reminders.mjs --log-level=error && TZ=America/Tijuana node node_modules/.cache/test-reminders.mjs",
    "test:pibbi": "esbuild scripts/test-pibbi.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/test-pibbi.mjs --log-level=error && TZ=America/Tijuana node node_modules/.cache/test-pibbi.mjs",
    "test:login": "esbuild scripts/test-login.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/test-login.mjs --log-level=error && TZ=America/Tijuana node node_modules/.cache/test-login.mjs",
    "test:capture": "esbuild scripts/test-capture.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/test-capture.mjs --log-level=error && TZ=America/Tijuana node node_modules/.cache/test-capture.mjs",
    "test:captura-local": "esbuild scripts/test-captura-local.ts --bundle --platform=node --format=esm --external:tesseract.js --outfile=node_modules/.cache/test-captura-local.mjs --log-level=error && TZ=America/Tijuana node node_modules/.cache/test-captura-local.mjs",
    "test:sw": "esbuild scripts/test-sw.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/test-sw.mjs --log-level=error && TZ=America/Tijuana node node_modules/.cache/test-sw.mjs",
    "test:push": "node scripts/test-push.mjs",
    "test:planes": "esbuild scripts/test-planes.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/test-planes.mjs --log-level=error && TZ=America/Tijuana node node_modules/.cache/test-planes.mjs",
    "postinstall": "node scripts/generate-icons.mjs",
    "test:tema": "esbuild scripts/test-tema.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/test-tema.mjs --log-level=error && TZ=America/Tijuana node node_modules/.cache/test-tema.mjs"
  },
  "type": "module",
  "version": "1.0.0"
}