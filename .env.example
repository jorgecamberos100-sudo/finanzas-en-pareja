# Copia este archivo como .env (nunca subas el .env real a GitHub)
# Supabase → Settings → API
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key-publica-aqui

# Opcional: URL pública de la app (para invitaciones por enlace)
VITE_APP_URL=http://localhost:5173

# Opcional: clave pública VAPID para las notificaciones push de recordatorios.
# Es pública y puede ir en el frontend (la privada NO: va en secretos de Supabase).
# Se genera con: npx -y web-push generate-vapid-keys
# Sin esta variable, las alarmas solo suenan con la app abierta. Ver README -> "Recordatorios y alarmas".
VITE_VAPID_PUBLIC_KEY=

# --- Chat de captura (opcional; la captura manual funciona sin esto) ---
# Las llaves de IA NO van en este archivo ni en el frontend.
# Se guardan como SECRETOS de Supabase (Dashboard -> Edge Functions -> Secrets,
# o: supabase secrets set CLOUDFLARE_ACCOUNT_ID=... CLOUDFLARE_API_TOKEN=...)
#   CLOUDFLARE_ACCOUNT_ID   (obligatorio para el chat; cuenta gratis, sin tarjeta)
#   CLOUDFLARE_API_TOKEN    (obligatorio; token con permiso Workers AI)
#   GROQ_API_KEY            (opcional, respaldo de voz/texto, gratis sin tarjeta)
#   ZAI_API_KEY             (opcional, respaldo de visión para libretas, modelos Flash $0)
#   VAPID_PUBLIC_KEY / VAPID_PRIVATE_KEY / VAPID_SUBJECT
#                           (solo para el push de recordatorios con la app cerrada;
#                            se generan con: npx -y web-push generate-vapid-keys)
# NO uses Gemini free en producción: entrena con tus datos.
# Ver README -> "Chat de captura".
